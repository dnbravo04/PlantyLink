rules_version = '2';

// PlantyLink Storage: only profile photos for now.
// Reads happen through tokenized download URLs (stored at
// usuarios/{uid}/foto_url in RTDB), so read access can stay owner-only.
service firebase.storage {
  match /b/{bucket}/o {
    // Profile photo: usuarios/{uid}/perfil.jpg — owner-only.
    // On delete request.resource is null, hence the null-check.
    match /usuarios/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && (request.resource == null
                       || (request.resource.size < 2 * 1024 * 1024
                           && request.resource.contentType.matches('image/.*')));
    }

    // Everything else: denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

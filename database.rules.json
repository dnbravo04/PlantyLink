{
  "rules": {
    // ── Default: deny everything ─────────────────────────────────────────────
    ".read": false,
    ".write": false,

    // ── Device-scoped data ──────────────────────────────────────────────────
    // Access granted to authenticated users whose ACTIVE device (esp32_id)
    // matches, or who have the device registered in their multi-device list
    // (usuarios/{uid}/dispositivos/{esp32Id}).
    // Note: Cloud Functions (Admin SDK) bypass these rules, and the future
    // ESP32 firmware will need its own auth strategy to write sensor data.
    "devices": {
      "$esp32Id": {
        ".read":  "auth != null && (root.child('usuarios').child(auth.uid).child('esp32_id').val() === $esp32Id || root.child('usuarios').child(auth.uid).child('dispositivos').child($esp32Id).exists())",
        ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('esp32_id').val() === $esp32Id || root.child('usuarios').child(auth.uid).child('dispositivos').child($esp32Id).exists())",

        // F0.3: index for orderByChild('timestamp') queries (history/alerts
        // screens + client-side history pruning). Without this, RTDB warns and
        // sorts client-side over the whole node.
        "history": { ".indexOn": ["timestamp"] },
        "alerts":  { ".indexOn": ["timestamp"] }
      }
    },

    // ── Per-user data: readable/writable only by the owner ───────────────────
    // .indexOn: the sensorAlerts Cloud Function queries usuarios by esp32_id.
    "usuarios": {
      ".indexOn": ["esp32_id"],
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        // Legacy inline profile photo (pre-Storage, base64 JPEG)
        "foto_b64": {
          ".validate": "newData.isString() && newData.val().length < 150000"
        },

        // Profile photo download URL (Firebase Storage)
        "foto_url": {
          ".validate": "newData.isString() && newData.val().length < 2048"
        }
      }
    },

    // ── Shared API response cache (Perenual plant data) ─────────────────────
    // F0.3 partial hardening: any authenticated user may still write (the app
    // caches from the client via CatalogService), but writes must match the
    // cache shape and may only land under the two known subtrees. This blocks
    // arbitrary-garbage bloat. NOTE: it does NOT stop a well-formed cache
    // *poisoning* — closing that requires moving writes behind a Cloud Function
    // that proxies Perenual, which is an app+CF change, not a rules-only one.
    "cached": {
      ".read":  "auth != null",
      ".write": "auth != null",
      "plants": {
        "$perenualId": {
          ".validate": "newData.child('cached_at').isNumber() && newData.hasChild('data')"
        }
      },
      "care_guides": {
        "$perenualId": {
          ".validate": "newData.child('cached_at').isNumber() && newData.hasChild('sections')"
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}

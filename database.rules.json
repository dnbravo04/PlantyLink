{
  "rules": {
    // ── Default: deny everything ─────────────────────────────────────────────
    ".read": false,
    ".write": false,

    // ── Device-scoped data ──────────────────────────────────────────────────
    // Access granted only to authenticated users whose linked esp32_id
    // matches the device node they're trying to read/write.
    "devices": {
      "$esp32Id": {
        ".read":  "auth != null && root.child('usuarios').child(auth.uid).child('esp32_id').val() === $esp32Id",
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('esp32_id').val() === $esp32Id",

        "sensors":     { ".validate": true },
        "history":     { ".validate": true },
        "controls":    { ".validate": true },
        "schedules":   { ".validate": true },
        "profile":     { ".validate": true },
        "calibration": { ".validate": true },
        "alerts":      { ".validate": true },
        "nfc_logs":    { ".validate": true }
      }
    },

    // ── Per-user data: readable/writable only by the owner ───────────────────
    "usuarios": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    // ── Shared API response cache (read/write by any authenticated user) ────
    "cached": {
      ".read":  "auth != null",
      ".write": "auth != null"
    }
  }
}

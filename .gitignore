# Secret keys — never commit the real file; use api_keys.dart.example as template
lib/core/api_keys.dart

# ESP32 firmware secrets (WiFi / Firebase device credentials) — see deuda #12.
# The .ino ships with placeholders; real credentials must go in a gitignored
# secrets.h once the firmware is refactored (Fase 2, post-demo).
firmware/**/secrets.h

# Release keystore & signing config — never commit to source control
android/app/*.jks
android/app/*.keystore
android/key.properties

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
